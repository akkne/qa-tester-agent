{
  "Agent": {
    "ArtifactRoot": "/tmp/qa-agent-artifacts",
    "WorkspaceRoot": "/tmp/qa-agent-worktrees",
    "RunTimeoutMinutes": 75,
    "StageTimeoutMinutes": 15
  },
  "Profiles": {
    "demo": {
      "ProfileVersion": 16,
      "ExecutionMode": "lead-qualification",
      "SpecificationDirectory": "docs/qa",
      "AllowedTestDirectories": ["tests/LeadQualification.Tests"],
      "AllowedReportDirectory": "revision",
      "Build": { "Executable": "dotnet", "Arguments": ["build", "LeadQualification.slnx", "--nologo", "-warnaserror"] },
      "Test": { "Executable": "dotnet", "Arguments": ["run", "--project", "tests/LeadQualification.Tests/LeadQualification.Tests.csproj", "--no-build", "--no-restore"] },
      "Start": { "Executable": "docker", "Arguments": ["compose", "--profile", "app", "up", "-d", "--build"] },
      "Stop": { "Executable": "docker", "Arguments": ["compose", "--profile", "app", "down"] },
      "HealthcheckPath": "/health"
    }
  }
}
