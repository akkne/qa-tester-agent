{
  "Agent": {
    "ArtifactRoot": "/tmp/qa-agent-artifacts",
    "WorkspaceRoot": "/tmp/qa-agent-worktrees",
    "RunTimeoutMinutes": 45,
    "StageTimeoutMinutes": 15
  },
  "Profiles": {
    "demo": {
      "ProfileVersion": 3,
      "SpecificationDirectory": "demo/docs/specs",
      "AllowedTestDirectories": ["demo/Demo.Tests"],
      "AllowedReportDirectory": "revision",
      "Build": { "Executable": "docker", "Arguments": ["compose", "-f", "demo/compose.yaml", "build", "app", "tests"] },
      "Test": { "Executable": "docker", "Arguments": ["compose", "-f", "demo/compose.yaml", "run", "--rm", "tests"] },
      "Start": { "Executable": "docker", "Arguments": ["compose", "-f", "demo/compose.yaml", "up", "-d", "app", "db"] },
      "Stop": { "Executable": "docker", "Arguments": ["compose", "-f", "demo/compose.yaml", "down", "--volumes"] },
      "HealthcheckPath": "/healthz"
    }
  }
}
